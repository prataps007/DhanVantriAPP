<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.KnowYourGreensActivity">

    <!-- Back button at top-left corner -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back Icon"
        android:src="@drawable/ic_black_color_back_24dp"
        app:tint="@android:color/black" />

    <!-- Search icon at top-right corner -->
    <ImageButton
        android:id="@+id/searchIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Search Icon"
        android:src="@android:drawable/ic_menu_search"
        app:tint="@android:color/black" />

    <!-- Search bar that becomes visible on search icon click -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_below="@id/backButton"
        android:padding="8dp">

        <SearchView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:queryHint="Search..." />

        <ImageButton
            android:id="@+id/voiceSearchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Voice Search"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@android:color/black" />
    </LinearLayout>

    <!-- RecyclerView for Recent Searches -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recentSearchesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchBar"
        android:visibility="gone"
        android:padding="8dp" />

    <!-- Upload Image Button in the center of the page -->
    <Button
        android:id="@+id/uploadButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Upload Image" />

    <!-- RecyclerView for Search Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResultsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/recentSearchesRecyclerView"
        android:visibility="gone"
        android:padding="8dp"
        tools:listitem="@layout/item_plant_details"/>
</RelativeLayout>
